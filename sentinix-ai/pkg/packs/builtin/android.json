{
 "name": "android",
 "version": "1.0.0",
 "stacks": [
  "android"
 ],
 "author": "Kolta Labs",
 "rules": [
  {
   "id": "exported-component",
   "severity": "medium",
   "cwe": "CWE-926",
   "message": "Exported component without a permission (launcher activities are exempt)",
   "remediation": "Set android:exported=\"false\" or require android:permission.",
   "files": [
    "AndroidManifest.xml"
   ],
   "pattern": "<(activity|service|receiver|provider)\\b[^>]*android:exported=\"true\"[^>]*?(?:/>|>.*?</(?:activity|service|receiver|provider)>)",
   "unless": "android:permission|android\\.intent\\.action\\.MAIN",
   "multiline": true
  },
  {
   "id": "allow-backup",
   "severity": "low",
   "cwe": "CWE-530",
   "message": "Backups enabled",
   "remediation": "Set android:allowBackup=\"false\" or restrict with backup rules.",
   "files": [
    "AndroidManifest.xml"
   ],
   "pattern": "android:allowBackup=\"true\""
  },
  {
   "id": "cleartext-traffic",
   "severity": "medium",
   "cwe": "CWE-319",
   "message": "Cleartext HTTP allowed",
   "remediation": "Remove usesCleartextTraffic and use HTTPS.",
   "files": [
    "AndroidManifest.xml"
   ],
   "pattern": "android:usesCleartextTraffic=\"true\""
  },
  {
   "id": "debuggable",
   "severity": "high",
   "cwe": "CWE-489",
   "message": "App marked debuggable",
   "remediation": "Remove android:debuggable from release builds.",
   "files": [
    "AndroidManifest.xml"
   ],
   "pattern": "android:debuggable=\"true\""
  },
  {
   "id": "webview-js-interface",
   "severity": "high",
   "cwe": "CWE-749",
   "message": "JavaScript bridge exposed to web content",
   "remediation": "Avoid addJavascriptInterface or restrict to trusted origins.",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "\\.addJavascriptInterface\\("
  },
  {
   "id": "webview-file-access",
   "severity": "high",
   "cwe": "CWE-200",
   "message": "WebView file access enabled",
   "remediation": "Keep file access disabled.",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "(allowUniversalAccessFromFileURLs|allowFileAccessFromFileURLs)\\s*=\\s*true|setAllow(Universal|File)Access\\w*\\(true\\)"
  },
  {
   "id": "webview-ssl-proceed",
   "severity": "high",
   "cwe": "CWE-295",
   "message": "WebView ignores TLS errors",
   "remediation": "Cancel the request on SSL errors.",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "handler\\??\\.proceed\\(\\)"
  },
  {
   "id": "world-accessible-file",
   "severity": "high",
   "cwe": "CWE-276",
   "message": "World readable/writable file mode",
   "remediation": "Use MODE_PRIVATE.",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "MODE_WORLD_(READABLE|WRITEABLE)"
  },
  {
   "id": "prefs-secret",
   "severity": "medium",
   "cwe": "CWE-312",
   "message": "Secret stored in plain SharedPreferences",
   "remediation": "Use EncryptedSharedPreferences or the Keystore.",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "putString\\(\\s*\"(password|passwd|token|secret|api_?key)\\w*\""
  },
  {
   "id": "trust-all-certs",
   "severity": "high",
   "cwe": "CWE-295",
   "message": "TrustManager accepts every certificate",
   "remediation": "Delegate to the platform TrustManager.",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "checkServerTrusted\\([^)]*\\)\\s*(:\\s*\\w+\\s*)?\\{\\s*\\}",
   "multiline": true
  },
  {
   "id": "weak-crypto",
   "severity": "high",
   "cwe": "CWE-327",
   "message": "Weak cipher or hash",
   "remediation": "Use AES-GCM and SHA-256 or better.",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "getInstance\\(\\s*\"(AES/ECB[^\"]*|DES[^\"]*|MD5|SHA-?1)\""
  },
  {
   "id": "sql-string-template",
   "severity": "high",
   "cwe": "CWE-89",
   "message": "SQL built with string interpolation",
   "remediation": "Use bound parameters.",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "(execSQL|rawQuery)\\(\\s*\"[^\"]*\\$"
  },
  {
   "id": "pending-intent-mutability",
   "severity": "high",
   "cwe": "CWE-927",
   "message": "PendingIntent created with flag 0 allows malicious intent redirection",
   "remediation": "Specify PendingIntent.FLAG_IMMUTABLE (or FLAG_MUTABLE if explicitly required).",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "PendingIntent\\.(?:getActivity|getBroadcast|getService|getForegroundService)\\([^)]*\\b0\\s*\\)"
  },
  {
   "id": "tapjacking-protection",
   "severity": "medium",
   "cwe": "CWE-1021",
   "message": "Touch filtering explicitly disabled allowing tapjacking and overlay attacks",
   "remediation": "Set filterTouchesWhenObscured to true.",
   "files": [
    "*.kt",
    "*.java",
    "*.xml"
   ],
   "pattern": "(?:setFilterTouchesWhenObscured\\(false\\)|android:filterTouchesWhenObscured=\"false\")"
  },
  {
   "id": "hardcoded-keystore-password",
   "severity": "high",
   "cwe": "CWE-798",
   "message": "Hardcoded password used to load KeyStore",
   "remediation": "Do not hardcode KeyStore passwords; for AndroidKeyStore pass null.",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "keyStore\\.load\\s*\\([^,]+,\\s*\"[^\"]+\"\\.toCharArray\\(\\)\\)"
  },
  {
   "id": "insecure-broadcast-receiver",
   "severity": "medium",
   "cwe": "CWE-925",
   "message": "Dynamic BroadcastReceiver registered without explicit export flags",
   "remediation": "Use ContextCompat.registerReceiver with RECEIVER_NOT_EXPORTED.",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "registerReceiver\\s*\\([^,]+,\\s*[^,)]+\\s*\\)",
   "unless": "RECEIVER_NOT_EXPORTED|RECEIVER_EXPORTED"
  },
  {
   "id": "android/external-storage-write",
   "severity": "high",
   "cwe": "CWE-276",
   "message": "Direct access to shared external storage exposes private app data to other applications",
   "remediation": "Use internal app storage (context.filesDir) or Android MediaStore / Storage Access Framework.",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "Environment\\.getExternalStorage(?:Public)?Directory\\("
  },
  {
   "id": "android/static-iv-cbc",
   "severity": "critical",
   "cwe": "CWE-329",
   "message": "Static or hardcoded Initialization Vector (IV) enables cryptographic replay and plaintext recovery",
   "remediation": "Generate a unique cryptographically random IV using SecureRandom().nextBytes().",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "IvParameterSpec\\s*\\(\\s*(?:\"[^\"]+\"|[^\\n,)]*\\.toByteArray\\(\\)|new\\s+byte\\[\\])"
  },
  {
   "id": "android/insecure-random",
   "severity": "medium",
   "cwe": "CWE-338",
   "message": "Pseudo-random generator (java.util.Random / kotlin.random.Random) used for security token or cryptographic key",
   "remediation": "Use java.security.SecureRandom for all security-sensitive values.",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "(?i)(?:token|nonce|secret|key|salt|iv)\\s*[:=].*(?:java\\.util\\.Random|kotlin\\.random\\.Random)"
  },
  {
   "id": "android/screen-recording-sensitive-screen",
   "severity": "medium",
   "cwe": "CWE-200",
   "message": "FLAG_SECURE cleared on Activity window, allowing unauthorized screenshots and screen recording",
   "remediation": "Keep WindowManager.LayoutParams.FLAG_SECURE enabled on sensitive authentication/financial screens.",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "clearFlags\\s*\\([^)]*FLAG_SECURE"
  },
  {
   "id": "android/clipboard-data-leak",
   "severity": "medium",
   "cwe": "CWE-200",
   "message": "Sensitive data placed into system clipboard without EXTRA_IS_SENSITIVE flag",
   "remediation": "Attach PersistableBundle with ClipDescription.EXTRA_IS_SENSITIVE to mask in clipboard history.",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "clipboard\\.setPrimaryClip\\s*\\(",
   "unless": "EXTRA_IS_SENSITIVE|isSensitive"
  },
  {
   "id": "android/implicit-intent-broadcast",
   "severity": "high",
   "cwe": "CWE-927",
   "message": "Implicit broadcast sent without targeting a specific package name",
   "remediation": "Call intent.setPackage(context.packageName) or use explicit Intent.",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "sendBroadcast\\s*\\(\\s*Intent\\s*\\([^)]*\\)\\s*\\)",
   "unless": "setPackage"
  },
  {
   "id": "android/sticky-broadcast-deprecated",
   "severity": "high",
   "cwe": "CWE-925",
   "message": "sendStickyBroadcast is deprecated and susceptible to interception and spoofing",
   "remediation": "Use regular broadcasts with permissions or dynamic state observers.",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "\\bsendSticky(?:Ordered)?Broadcast\\s*\\("
  },
  {
   "id": "android/intent-redirection",
   "severity": "high",
   "cwe": "CWE-926",
   "message": "Untrusted Intent forwarded directly to startActivity enables Intent redirection attacks",
   "remediation": "Validate component target against explicit whitelist before forwarding intents.",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "startActivity\\s*\\(\\s*(?:getIntent\\(\\)\\.|intent\\.)getParcelableExtra\\("
  },
  {
   "id": "android/content-provider-grant-uri-all",
   "severity": "high",
   "cwe": "CWE-732",
   "message": "ContentProvider sets grantUriPermissions=true without restricting paths via grant-uri-permission",
   "remediation": "Limit URI permission delegation to specific subpaths with <grant-uri-permission> tags.",
   "files": [
    "AndroidManifest.xml"
   ],
   "pattern": "<provider\\b[^>]*android:grantUriPermissions=\"true\"",
   "unless": "grant-uri-permission"
  },
  {
   "id": "android/custom-permission-normal",
   "severity": "high",
   "cwe": "CWE-276",
   "message": "Custom permission defined with protectionLevel=normal can be granted automatically to third-party apps",
   "remediation": "Use android:protectionLevel=\"signature\" for private internal permissions.",
   "files": [
    "AndroidManifest.xml"
   ],
   "pattern": "<permission\\b[^>]*android:protectionLevel=\"normal\""
  },
  {
   "id": "android/dynamic-code-loading",
   "severity": "critical",
   "cwe": "CWE-94",
   "message": "Dynamic code execution via DexClassLoader / PathClassLoader introduces remote code execution risk",
   "remediation": "Avoid dynamic bytecode loading or verify code signing certificates cryptographically.",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "(?:DexClassLoader|PathClassLoader|InMemoryDexClassLoader)\\s*\\("
  },
  {
   "id": "android/biometric-weak-crypto",
   "severity": "high",
   "cwe": "CWE-287",
   "message": "BiometricPrompt authenticated without CryptoObject; vulnerable to instrumentation and hooking bypasses",
   "remediation": "Pass BiometricPrompt.CryptoObject(cipher) into authenticate() to unlock cryptographic keys.",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "biometricPrompt\\.authenticate\\s*\\(\\s*promptInfo\\s*\\)"
  },
  {
   "id": "android/hardcoded-aes-key",
   "severity": "critical",
   "cwe": "CWE-798",
   "message": "Hardcoded byte array or string used as SecretKeySpec",
   "remediation": "Generate and retrieve AES keys from AndroidKeyStore.",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "SecretKeySpec\\s*\\(\\s*(?:\"[^\"]+\"|[^\\n,)]*\\.toByteArray\\(\\)|new\\s+byte\\[\\])"
  },
  {
   "id": "android/rsa-no-padding",
   "severity": "critical",
   "cwe": "CWE-327",
   "message": "RSA cipher initialized without OAEP padding (NoPadding enables chosen-ciphertext attacks)",
   "remediation": "Use RSA/ECB/OAEPWithSHA-256AndMGF1Padding.",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "Cipher\\.getInstance\\s*\\(\\s*\"RSA/(?:ECB|NONE)/NoPadding\""
  },
  {
   "id": "android/webview-save-passwords",
   "severity": "medium",
   "cwe": "CWE-522",
   "message": "WebView password auto-save enabled",
   "remediation": "Disable password saving with webSettings.setSavePassword(false).",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "(?:setSavePassword\\(true\\)|savePassword\\s*=\\s*true)"
  },
  {
   "id": "android/custom-hostname-verifier-all",
   "severity": "critical",
   "cwe": "CWE-295",
   "message": "HostnameVerifier blindly trusts any host, enabling Man-in-the-Middle (MITM) attacks",
   "remediation": "Use HttpsURLConnection.getDefaultHostnameVerifier() or pin explicit domain certificates.",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "HostnameVerifier\\s*\\{[^}]*true\\s*\\}|ALLOW_ALL_HOSTNAME_VERIFIER",
   "multiline": true
  },
  {
   "id": "android/network-security-config-override-pins",
   "severity": "high",
   "cwe": "CWE-295",
   "message": "Network Security Config specifies overridePins=true, permitting certificate pin bypasses",
   "remediation": "Disable overridePins or restrict overrides strictly to debug-overrides.",
   "files": [
    "*.xml"
   ],
   "pattern": "<certificates\\b[^>]*overridePins=\"true\""
  },
  {
   "id": "android/sensitive-log-leak",
   "severity": "high",
   "cwe": "CWE-532",
   "message": "Sensitive credentials, passwords, or tokens printed to logcat",
   "remediation": "Strip all authentication tokens, credentials, and PII from log output.",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "\\b(?:Log\\.[dviwe]|println|Timber\\.[dviwe])\\s*\\([^)]*(?:password|passwd|authToken|bearerToken|apiKey|secretKey|creditCard|cvv)\\b"
  },
  {
   "id": "android/hardcoded-google-api-key",
   "severity": "high",
   "cwe": "CWE-798",
   "message": "Hardcoded Google/Firebase API key detected in source code or manifest",
   "remediation": "Inject keys at build time via BuildConfig or environment variables and restrict key scopes in Google Cloud Console.",
   "files": [
    "*.kt",
    "*.java",
    "*.xml",
    "AndroidManifest.xml"
   ],
   "pattern": "AIzaSy[0-9A-Za-z-_]{33}"
  },
  {
   "id": "android/task-hijacking-strandhogg",
   "severity": "medium",
   "cwe": "CWE-1021",
   "message": "Activity launchMode=singleTask without empty taskAffinity allows StrandHogg task hijacking",
   "remediation": "Add android:taskAffinity=\"\" to singleTask activities.",
   "files": [
    "AndroidManifest.xml"
   ],
   "pattern": "<activity\\b[^>]*android:launchMode=\"singleTask\"",
   "unless": "android:taskAffinity"
  },
  {
   "id": "android/biometric-enrollment-invalidation",
   "severity": "high",
   "cwe": "CWE-287",
   "message": "KeyGenParameterSpec explicitly disables key invalidation upon new biometric enrollment",
   "remediation": "Set setInvalidatedByBiometricEnrollment(true) so cryptographic keys are wiped if new fingerprints are enrolled.",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "\\.setInvalidatedByBiometricEnrollment\\s*\\(\\s*false\\s*\\)"
  },
  {
   "id": "android/securerandom-fixed-seed",
   "severity": "critical",
   "cwe": "CWE-330",
   "message": "SecureRandom initialized with a fixed seed undermines cryptographic entropy",
   "remediation": "Do not pass a constant seed to SecureRandom; rely on system default hardware entropy.",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "SecureRandom\\s*\\([^)]*\\)\\.setSeed\\s*\\("
  },
  {
   "id": "android/app-link-missing-autoverify",
   "severity": "high",
   "cwe": "CWE-601",
   "message": "HTTP/HTTPS intent filter missing autoVerify=true allows unauthorized apps to hijack App Links and OAuth callbacks",
   "remediation": "Add android:autoVerify=\"true\" to intent-filter handling HTTP/HTTPS schemes.",
   "files": [
    "AndroidManifest.xml"
   ],
   "pattern": "<intent-filter\\b[^>]*>",
   "unless": "android:autoVerify=\"true\""
  },
  {
   "id": "android/custom-scheme-oauth",
   "severity": "high",
   "cwe": "CWE-926",
   "message": "Custom scheme used for OAuth or authentication redirect; vulnerable to token theft by rogue applications",
   "remediation": "Use verified HTTPS App Links rather than custom URI schemes for authentication redirects.",
   "files": [
    "AndroidManifest.xml"
   ],
   "pattern": "android:scheme=\"[a-zA-Z0-9_-]+\"[^>]*android:host=\"(?:oauth|auth|callback|login)\""
  },
  {
   "id": "android/keyboard-personalized-learning-leak",
   "severity": "medium",
   "cwe": "CWE-200",
   "message": "Sensitive input field missing flagNoPersonalizedLearning; third-party keyboards may log keystrokes to cloud dictionaries",
   "remediation": "Add flagNoPersonalizedLearning to imeOptions.",
   "files": [
    "*.xml"
   ],
   "pattern": "imeOptions\\s*=\\s*\"[^\"]*\"",
   "unless": "flagNoPersonalizedLearning|noPersonalizedLearning"
  },
  {
   "id": "android/notification-lockscreen-leak",
   "severity": "high",
   "cwe": "CWE-200",
   "message": "Notification set with VISIBILITY_PUBLIC exposes OTPs or sensitive user data on locked screens",
   "remediation": "Set notification visibility to VISIBILITY_PRIVATE or VISIBILITY_SECRET.",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "setVisibility\\s*\\(\\s*NotificationCompat\\.VISIBILITY_PUBLIC\\s*\\)"
  },
  {
   "id": "android/backup-rule-includes-credentials",
   "severity": "high",
   "cwe": "CWE-530",
   "message": "Backup configuration includes sensitive credential storage or all SharedPreferences in cloud backup",
   "remediation": "Exclude files containing authentication tokens and cryptographic keys from backup rules.",
   "files": [
    "*.xml"
   ],
   "pattern": "<include\\b[^>]*domain=\"(?:sharedpref|root|database)\"[^>]*path=\"[^\"]*(?:token|auth|key|secret|credential|\\.)[^\"]*\""
  },
  {
   "id": "android/content-provider-path-traversal",
   "severity": "high",
   "cwe": "CWE-22",
   "message": "ContentProvider openFileHelper directly uses getLastPathSegment without canonical path bounds validation",
   "remediation": "Verify canonicalPath starts with designated base directory before returning file descriptor.",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "openFile(?:Helper)?\\s*\\([^)]*getLastPathSegment\\(\\)",
   "unless": "canonicalPath|getCanonicalPath"
  },
  {
   "id": "android/content-resolver-sql-injection",
   "severity": "high",
   "cwe": "CWE-89",
   "message": "ContentResolver query built with string concatenation in selection parameter",
   "remediation": "Use parameterized selection arguments (?) rather than string concatenation.",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "contentResolver\\.query\\s*\\([^,]+,\\s*[^,]+,\\s*[^,]*\\+\\s*[^,]+"
  },
  {
   "id": "android/unsafe-native-load",
   "severity": "critical",
   "cwe": "CWE-829",
   "message": "System.load loading native library from writable app or storage path",
   "remediation": "Bundle libraries in APK / AAB and use System.loadLibrary() to load from read-only system library path.",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "System\\.load\\s*\\(\\s*(?:context\\.|Environment\\.|\"/data/|getExternal)"
  },
  {
   "id": "android/insecure-network-security-cleartext-domain",
   "severity": "high",
   "cwe": "CWE-319",
   "message": "Network Security Config domain-config enables cleartextTrafficPermitted=true",
   "remediation": "Disable cleartext HTTP on all production domains.",
   "files": [
    "*.xml"
   ],
   "pattern": "<domain-config\\b[^>]*cleartextTrafficPermitted=\"true\""
  },
  {
   "id": "android/trustkit-wildcard-pins",
   "severity": "high",
   "cwe": "CWE-295",
   "message": "Certificate pinning configured with legacy SHA-1 hash instead of SHA-256",
   "remediation": "Use sha256/ pin hashes and supply a backup pin per RFC 7469.",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "CertificatePinner\\.Builder\\(\\)\\.add\\([^,]+,\\s*\"sha1/"
  },
  {
   "id": "android/coroutine-unconfined-dispatcher-auth",
   "severity": "medium",
   "cwe": "CWE-662",
   "message": "Authentication or token state mutation executed on Dispatchers.Unconfined risks cross-thread race conditions",
   "remediation": "Use Dispatchers.Default or a single-threaded mutex dispatcher for state mutations.",
   "files": [
    "*.kt"
   ],
   "pattern": "withContext\\s*\\(\\s*Dispatchers\\.Unconfined\\s*\\)\\s*\\{[^}]*(?:token|auth|session|password)"
  },
  {
   "id": "android/shared-user-id",
   "severity": "high",
   "cwe": "CWE-250",
   "message": "sharedUserId attribute breaks Android app sandbox isolation and is deprecated",
   "remediation": "Remove android:sharedUserId from manifest to enforce strict process sandboxing.",
   "files": [
    "AndroidManifest.xml"
   ],
   "pattern": "android:sharedUserId\\s*="
  },
  {
   "id": "android/test-only-flag",
   "severity": "high",
   "cwe": "CWE-489",
   "message": "android:testOnly=true enabled in application manifest",
   "remediation": "Remove android:testOnly before distributing release APK.",
   "files": [
    "AndroidManifest.xml"
   ],
   "pattern": "android:testOnly\\s*=\\s*\"true\""
  },
  {
   "id": "android/mock-location-allowed",
   "severity": "medium",
   "cwe": "CWE-200",
   "message": "Mock location mode explicitly enabled or accepted without anti-spoofing verification",
   "remediation": "Disable mock provider mode and verify isFromMockProvider in production fraud detection.",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "(?:setMockMode\\s*\\(\\s*true\\s*\\)|setTestProviderEnabled\\s*\\([^,]+,\\s*true\\))"
  },
  {
   "id": "android/unencrypted-room-database",
   "severity": "high",
   "cwe": "CWE-312",
   "message": "Room database constructed without SQLCipher encryption factory",
   "remediation": "Encrypt SQLite database with SQLCipher openHelperFactory(SupportFactory(passphrase)).",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "Room\\.databaseBuilder\\s*\\([^)]*\\)\\s*\\.build\\(\\)",
   "unless": "openHelperFactory|SupportFactory|SQLCipher"
  },
  {
   "id": "android/keystore-user-auth-timeout-infinite",
   "severity": "high",
   "cwe": "CWE-305",
   "message": "KeyGenParameterSpec sets user authentication timeout to 0 (permanently unlocked upon first auth)",
   "remediation": "Specify a non-zero timeout in seconds or require per-operation authentication.",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "setUserAuthenticationParameters\\s*\\(\\s*0\\s*,"
  },
  {
   "id": "android/unbounded-broadcast-permission",
   "severity": "medium",
   "cwe": "CWE-732",
   "message": "registerReceiver invoked without receiver permission parameter",
   "remediation": "Supply an explicit signature permission when registering dynamic receivers.",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "registerReceiver\\s*\\([^,]+,\\s*[^,]+,\\s*null\\s*,\\s*null\\s*\\)"
  },
  {
   "id": "android/insecure-webview-cache",
   "severity": "low",
   "cwe": "CWE-312",
   "message": "Deprecated AppCache enabled in WebView",
   "remediation": "Do not enable AppCache; use standard HTTP caching or set LOAD_NO_CACHE.",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "setAppCacheEnabled\\s*\\(\\s*true\\s*\\)"
  },
  {
   "id": "android/ssl-error-toast-exposure",
   "severity": "low",
   "cwe": "CWE-209",
   "message": "onReceivedSslError displays raw SSL error text to user via Toast, leaking internal infrastructure details",
   "remediation": "Log error securely internally and show generic error message to user.",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "onReceivedSslError\\([^)]*\\)\\s*\\{[^}]*Toast\\.makeText"
  },
  {
   "id": "android/file-provider-external-path",
   "severity": "high",
   "cwe": "CWE-552",
   "message": "FileProvider exposes root of external storage via path=\".\"",
   "remediation": "Restrict FileProvider paths to specific sub-directories rather than whole root.",
   "files": [
    "*.xml"
   ],
   "pattern": "<external-(?:path|files-path|cache-path)\\b[^>]*path=\"\\.\""
  },
  {
   "id": "android/weak-kdf-iteration-count",
   "severity": "high",
   "cwe": "CWE-326",
   "message": "PBKDF2 iteration count below 10,000 allows offline GPU dictionary attacks",
   "remediation": "Use at least 100,000 iterations for PBKDF2 in modern Android applications.",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "PBEKeySpec\\s*\\([^,]+,\\s*[^,]+,\\s*(?:[1-9][0-9]{0,3}|[1-9][0-9]{4})\\s*,"
  },
  {
   "id": "android/insecure-bluetooth-insecure-rfcomm",
   "severity": "high",
   "cwe": "CWE-319",
   "message": "createInsecureRfcommSocketToServiceRecord creates unencrypted Bluetooth connection without pairing",
   "remediation": "Use createRfcommSocketToServiceRecord() to enforce Bluetooth encryption and pairing.",
   "files": [
    "*.kt",
    "*.java"
   ],
   "pattern": "createInsecureRfcommSocketToServiceRecord\\s*\\("
  }
 ],
