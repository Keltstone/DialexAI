{
  "name": "php",
  "version": "1.0.0",
  "stacks": [
    "php"
  ],
  "author": "Keltstone Systems",
  "rules": [
    {
      "id": "php/sql-injection",
      "severity": "high",
      "cwe": "CWE-89",
      "message": "Potential SQL injection via variable concatenation in query",
      "remediation": "Use PDO prepared statements: $stmt = $pdo->prepare('SELECT * FROM users WHERE id = ?'); $stmt->execute([$id]);",
      "files": [
        "*.php"
      ],
      "pattern": "(?:mysqli_query\\s*\\([^,]+,\\s*|\\$(?:pdo|db)->query\\s*\\()[^;]*\\$(?:_GET|_POST|_REQUEST|[a-zA-Z0-9_]+)"
    },
    {
      "id": "php/command-injection",
      "severity": "critical",
      "cwe": "CWE-78",
      "message": "System command execution with variable parameters",
      "remediation": "Avoid shell execution or strictly sanitize with escapeshellcmd() and escapeshellarg().",
      "files": [
        "*.php"
      ],
      "pattern": "\\b(?:exec|system|shell_exec|passthru)\\s*\\([^;]*\\$",
      "unless": "escapeshellarg|escapeshellcmd"
    },
    {
      "id": "php/insecure-unserialize",
      "severity": "critical",
      "cwe": "CWE-502",
      "message": "Insecure unserialize() enables PHP Object Injection and Remote Code Execution",
      "remediation": "Use json_decode() or pass ['allowed_classes' => false] to unserialize().",
      "files": [
        "*.php"
      ],
      "pattern": "\\bunserialize\\s*\\([^)]*\\$",
      "unless": "allowed_classes"
    },
    {
      "id": "php/xss-echo-unencoded",
      "severity": "medium",
      "cwe": "CWE-79",
      "message": "Direct unencoded output of request variable leads to Cross-Site Scripting (XSS)",
      "remediation": "Escape with htmlspecialchars($val, ENT_QUOTES, 'UTF-8').",
      "files": [
        "*.php"
      ],
      "pattern": "\\becho\\s+\\$_(?:GET|POST|REQUEST)\\["
    },
    {
      "id": "php/remote-file-inclusion",
      "severity": "critical",
      "cwe": "CWE-98",
      "message": "Direct include/require using request variable allows Remote File Inclusion (RFI)",
      "remediation": "Map requests to strict server-side whitelists before including files.",
      "files": [
        "*.php"
      ],
      "pattern": "\\b(?:include|include_once|require|require_once)\\s*\\(?\\s*\\$_(?:GET|POST|REQUEST)\\["
    },
    {
      "id": "php/ssrf-curl",
      "severity": "high",
      "cwe": "CWE-918",
      "message": "Server-Side Request Forgery via unvalidated curl CURLOPT_URL",
      "remediation": "Validate target URL and prohibit private subnet addresses.",
      "files": [
        "*.php"
      ],
      "pattern": "curl_setopt\\s*\\([^,]+,\\s*CURLOPT_URL\\s*,\\s*\\$_(?:GET|POST|REQUEST)\\["
    },
    {
      "id": "php/weak-random-rand",
      "severity": "medium",
      "cwe": "CWE-338",
      "message": "Insecure rand() or mt_rand() used to produce security token or secret",
      "remediation": "Use random_bytes() or random_int() for cryptographic security.",
      "files": [
        "*.php"
      ],
      "pattern": "(?i)(?:token|nonce|secret|password|key)\\s*=\\s*.*(?:\\brand|\\bmt_rand)\\s*\\("
    },
    {
      "id": "php/insecure-cookie-session",
      "severity": "medium",
      "cwe": "CWE-614",
      "message": "session_set_cookie_params sets insecure flags (secure=false)",
      "remediation": "Set secure=true and httponly=true in session cookies.",
      "files": [
        "*.php"
      ],
      "pattern": "session_set_cookie_params\\s*\\(\\s*\\d+\\s*,\\s*\"[^\"]*\"\\s*,\\s*\"[^\"]*\"\\s*,\\s*false"
    }
  ],
  "tests": [
    {
      "rule": "php/sql-injection",
      "file": "user.php",
      "bad": "$res = mysqli_query($conn, \"SELECT * FROM users WHERE email='\" . $_GET['email'] . \"'\");",
      "good": "$stmt = $pdo->prepare('SELECT * FROM users WHERE email = ?'); $stmt->execute([$_GET['email']]);"
    },
    {
      "rule": "php/command-injection",
      "file": "backup.php",
      "bad": "system(\"ping -c 1 \" . $ipAddress);",
      "good": "system(\"ping -c 1 \" . escapeshellarg($ipAddress));"
    },
    {
      "rule": "php/insecure-unserialize",
      "file": "session.php",
      "bad": "$data = unserialize($_COOKIE['user_data']);",
      "good": "$data = json_decode($_COOKIE['user_data'], true);"
    },
    {
      "rule": "php/xss-echo-unencoded",
      "file": "profile.php",
      "bad": "echo $_GET['name'];",
      "good": "echo htmlspecialchars($_GET['name'], ENT_QUOTES, 'UTF-8');"
    },
    {
      "rule": "php/remote-file-inclusion",
      "file": "index.php",
      "bad": "include($_GET['page']);",
      "good": "include($whitelist[$_GET['page']]);"
    },
    {
      "rule": "php/ssrf-curl",
      "file": "webhook.php",
      "bad": "curl_setopt($ch, CURLOPT_URL, $_GET['url']);",
      "good": "curl_setopt($ch, CURLOPT_URL, $safeUrl);"
    },
    {
      "rule": "php/weak-random-rand",
      "file": "reset.php",
      "bad": "$token = md5(rand());",
      "good": "$token = bin2hex(random_bytes(32));"
    },
    {
      "rule": "php/insecure-cookie-session",
      "file": "auth.php",
      "bad": "session_set_cookie_params(3600, \"/\", \"corp.internal\", false, false);",
      "good": "session_set_cookie_params(3600, \"/\", \"corp.internal\", true, true);"
    }
  ]
}
