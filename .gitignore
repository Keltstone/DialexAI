# ==============================================================================
# Dialex AI — Git Ignore Policy (Open-Source Sovereign Security)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Secrets, Environment Variables & API Credentials
# ------------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example
!.env.template

local.properties
secrets.properties
secret.properties
apikeys.properties
*.secret

# Cloud & Service Account JSON credentials
google-services.json
service-account*.json
credentials.json
token.json
auth.json
*.auth

# ------------------------------------------------------------------------------
# 2. Encrypted Vaults, Local Databases & Runtime Storage
# ------------------------------------------------------------------------------
# In-device & server local discussion storage
dialex.vault
*.vault
dialex.db
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.backup

# Root runtime data & discussion transcripts directory (anchored to root)
/data/
/storage/
/discussions/
/backups/
.dialex/
.artix/

# ------------------------------------------------------------------------------
# 3. Cryptographic Keys, Keystores & TLS/SSL Certificates
# ------------------------------------------------------------------------------
# Private keys & certificates (never commit private keys)
*.pem
*.key
*.crt
*.p12
*.pfx
*.cer
*.der

# Android & Java signing keystores
*.jks
*.keystore

# ------------------------------------------------------------------------------
